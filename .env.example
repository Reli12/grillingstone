# Optional overrides for Grilling Stone. Every one has a default, so none is needed to run the tool.
# Nothing loads this file automatically: set a value in your shell for one run, e.g.
#   GRILLINGSTONE_SERVER_PORT=6000 npm run dev
# (Other GRILLINGSTONE_* variables are set by the backend for each Claude session; never set them yourself.)

# Port of the local backend (HTTP API and websocket). The Vite dev server proxies /api to it.
GRILLINGSTONE_SERVER_PORT=5311

# Port of the UI (Vite dev server). The backend only accepts browser requests from this origin.
GRILLINGSTONE_WEB_PORT=5310

# Where Projects, Drafts, Glossaries, Transcripts, Templates and settings live. Must be a folder named data…
# directly inside the project (e.g. data-scratch for a throwaway run); anything else is refused at startup.
GRILLINGSTONE_DATA_DIR=data

# The Claude Code binary each session runs as `claude -p`. Change it to use another install or a stand-in.
GRILLINGSTONE_CLAUDE_BIN=claude